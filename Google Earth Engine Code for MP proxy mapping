var S2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED"),
    blacksburg = /* color: #d63000 */ee.Geometry.Point([-80.5645482338429, 37.19806003727215]),
    Points = ee.FeatureCollection("projects/ee-lrs/assets/LRS_locations");

//////////////////////////////////////////////////////
// Parameters and AOI                               //
//////////////////////////////////////////////////////

var winter_start = '2023-12-01';
var winter_end = '2024-03-01';

var AOI = Points.geometry().bounds();

//////////////////////////////////////////////////////
// Sentinel-2 Filtering + Masking                   //
//////////////////////////////////////////////////////

var S2_filtered = S2
  .filterDate(winter_start, winter_end)
  .filterBounds(AOI)
  .filterMetadata('CLOUDY_PIXEL_PERCENTAGE', 'less_than', 70);

function cloudWaterMask(img) {
  var scl = img.select('SCL');
  var mask = scl.eq(6).or(scl.eq(4)).or(scl.eq(5)).or(scl.eq(2)); //pick pixel classes of interest  -- see S2 bottom of tab "bands" for SCL value meanings 
  return img.updateMask(mask);
}

var sentinel = S2_filtered.map(cloudWaterMask);

//////////////////////////////////////////////////////
//     Indices: NDWI, NDTI, MP, Turbidity           //
//////////////////////////////////////////////////////

// Functions
function addIndices(img) {
  var ndwi = img.normalizedDifference(['B3', 'B8']).rename('NDWI');
  var ndti = img.normalizedDifference(['B4', 'B3']).rename('NDTI');
  return img.addBands(ndwi).addBands(ndti);
}


function addMP(img) {
  var mp = img.expression('10 ** (1.835 + 1.969 * ndti)', {
    ndti: img.select('NDTI')
  }).rename('MP');
  return img.addBands(mp);
}

function addTurbidity(img) {
  var turb = img.expression('16.578 + 55.729 * ndti', {
    ndti: img.select('NDTI')
  });
  turb = turb.updateMask(turb.gte(0)).rename('Turbidity'); //turbidity cannot be below 0 so mask any negative results
  return img.addBands(turb);
}

function clipToWater(img) {
  var waterMask = img.select('NDWI').gt(0);
  var mpWater = img.select('MP').updateMask(waterMask).rename('MP_water');
  var turbWater = img.select('Turbidity').updateMask(waterMask).rename('Turbidity_water');
  return img.addBands(mpWater).addBands(turbWater);
}

// Apply all functions to Sentinel-2 collection
var processed = sentinel
  .map(addIndices)
  .map(addMP)
  .map(addTurbidity)
  .map(clipToWater);


//////////////////////////////////////////////////////
// Visualization Parameters                         //
//////////////////////////////////////////////////////

// Display relevant geometries on the map.
Map.setCenter(-80.5655, 37.198, 14);

var MPviz = {
  min: 40,
  max: 150,
  palette: ['4112ff', '0affff', '10ff17', 'fbff00', 'ffa604', 'ff0000']
};

var turbViz = {
  min: 0,
  max: 30,
  palette: ['00ffff', '00ff00', 'ffff00', 'ff9900', 'ff0000']
};

var trueColorVis = {
  bands: ['B4', 'B3', 'B2'],
  min: 0,
  max: 3000,
  gamma: 1.2
};


/////////////////////////////////////////////////////////////////////////
// UI Slider for MP over Water with True color (RGB) as the background //
/////////////////////////////////////////////////////////////////////////
// =======================
// UI Slider for MP + RGB
// =======================

// Get image list & dates
var imageList = processed.toList(processed.size());
var dates = imageList.map(function(img) {
  return ee.Date(ee.Image(img).get('system:time_start')).format('YYYY-MM-dd');
}).getInfo();

// Create a label to show the selected date
var label = ui.Label('Date: ' + dates[0]);

var currentTrueColor = null;
var currentMP = null;

function showDate(index) {
  var img = ee.Image(imageList.get(index));
  var date = dates[index];

  var mpLayer = img.select('MP_water');
  var trueColorLayer = img.select(['B4', 'B3', 'B2']);

  if (currentTrueColor) Map.remove(currentTrueColor);
  if (currentMP) Map.remove(currentMP);

  currentTrueColor = ui.Map.Layer(trueColorLayer, trueColorVis, 'True Color - ' + date);
  currentMP = ui.Map.Layer(mpLayer, MPviz, 'MP Water - ' + date);
  Map.layers().add(currentTrueColor);
  Map.layers().add(currentMP);

  label.setValue('Date: ' + date);
}

var slider = ui.Slider({
  min: 0,
  max: dates.length - 1,
  step: 1,
  value: 0,
  style: {stretch: 'horizontal'},
  onChange: showDate
});

// Show the first date using the same code path
showDate(0);

// UI panel
var panel = ui.Panel({
  widgets: [
    ui.Label('MP + True Color (Slider)', {fontWeight: 'bold', fontSize: '16px'}),
    label,
    slider
  ],
  style: {
    width: '300px',
    position: 'top-right'
  }
});

Map.add(panel);



