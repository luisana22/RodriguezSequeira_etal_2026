//we want to exporte these MP proxy values to later compare with in situ MP values in Rstudio


var mpproxy = processed.select('MP')
var bands = mpproxy.toBands()


var reduced = bands.reduceRegions({ //selects values from pixels that are found within Points (in situ coordinates list)
  collection: Points,
  reducer: ee.Reducer.mean(),
  scale: 10,
});



Export.table.toDrive({
    collection: reduced, 
    description: 'MPproxy', 
    fileFormat: 'CSV'
})

